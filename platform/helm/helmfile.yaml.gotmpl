# Helmfile fetches upstream charts directly. OCI references are manifest-digest pinned.
repositories:
  - name: rustfs
    url: https://charts.rustfs.com
  - name: dex
    url: https://charts.dexidp.io
  - name: headlamp
    url: https://kubernetes-sigs.github.io/headlamp/
  - name: oauth2-proxy
    url: https://oauth2-proxy.github.io/manifests

helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  createNamespace: true
  historyMax: 5

releases:
  - name: local-path-provisioner
    namespace: local-path-provisioner
    # Upstream chart 0.0.37.
    chart: oci://ghcr.io/rancher/local-path-provisioner/charts/local-path-provisioner@sha256:81033683ce790e593524b2105945ee0d81bf6608f0c85eb5e0c1082cc74ff03d
    values:
      - values/local-path-provisioner.yaml

  - name: rustfs
    namespace: rustfs
    chart: rustfs/rustfs
    version: "1.0.5"
    postRenderer: domain-render
    postRendererArgs: [rustfs]
    needs:
      - local-path-provisioner/local-path-provisioner
    values:
      - values/rustfs.yaml

  - name: cert-manager
    namespace: cert-manager
    # Upstream chart v1.21.3.
    chart: oci://quay.io/jetstack/charts/cert-manager@sha256:e482675aec32862d323a9218293ff7de81192337998615e4378c56498473f240
    values:
      - values/cert-manager.yaml
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [wait, --for=condition=Established, crd/certificates.cert-manager.io, crd/issuers.cert-manager.io, --timeout=180s]

  - name: envoy-gateway
    namespace: envoy-gateway
    # Upstream chart v1.10.0.
    chart: oci://docker.io/envoyproxy/gateway-helm@sha256:dcb82a14c04b426615a71d97222c7edf9f5ff58b800d241e71ac5784ae6dc7b7
    values:
      - values/envoy-gateway.yaml
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [wait, --for=condition=Established, crd/gatewayclasses.gateway.networking.k8s.io, crd/gateways.gateway.networking.k8s.io, crd/httproutes.gateway.networking.k8s.io, crd/backends.gateway.envoyproxy.io, --timeout=180s]

  - name: agent-router-crds
    namespace: agent-router
    # Upstream chart v1.2.1; product renamed, upstream artifact names unchanged.
    chart: oci://docker.io/envoyproxy/ai-gateway-crds-helm@sha256:b1eafd2c27cd02e827210bcf6b3f05ebe9d2344f54152a7e0280420ed4edcf5e
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [wait, --for=condition=Established, crd/aigatewayroutes.aigateway.envoyproxy.io, crd/aiservicebackends.aigateway.envoyproxy.io, --timeout=180s]

  - name: agent-router
    namespace: agent-router
    chart: oci://docker.io/envoyproxy/ai-gateway-helm@sha256:21bf51ed7ff44d1bcebefea8ab211f2e69af0ec7833b492d65a9abc5150c85af
    needs:
      - cert-manager/cert-manager
      - envoy-gateway/envoy-gateway
      - agent-router/agent-router-crds
    values:
      - values/agent-router.yaml
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [-n, agent-router, wait, --for=condition=Ready, certificate/self-signed-cert-for-mutating-webhook, --timeout=180s]
      - events: [postsync]
        showlogs: true
        command: timeout
        args:
          - "180"
          - bash
          - -ec
          - 'until test -n "$(kubectl get mutatingwebhookconfiguration envoy-ai-gateway-gateway-pod-mutator.agent-router -o jsonpath="{.webhooks[0].clientConfig.caBundle}")"; do sleep 2; done'

  - name: kserve-crds
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-crd-minimal@sha256:62362337168d1675b8dc90a846dc9cd51af944f59160a42fc387755aca2fbfec
    hooks:
      - events: [postsync]
        command: kubectl
        args: [wait, --for=condition=Established, crd/inferenceservices.serving.kserve.io, crd/servingruntimes.serving.kserve.io, --timeout=180s]
  - name: kserve
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-resources@sha256:2d189c8c9d51e1ad658f9a973eaf9ea73b251305e7f93507adb1b559303f1e9a
    needs:
      - kserve/kserve-crds
      - cert-manager/cert-manager
    values:
      - values/kserve.yaml

  - name: dex
    namespace: dex
    chart: dex/dex
    version: "0.26.0"
    postRenderer: domain-render
    postRendererArgs: [dex]
    needs:
      - gateway/gateway
    values:
      - values/dex.yaml
      - podAnnotations:
          checksum/domain-config: '{{ readFile "domains/dex/job.py" | sha256sum }}'

  - name: headlamp
    namespace: headlamp
    chart: headlamp/headlamp
    version: "0.46.0"
    needs:
      - gateway/gateway
    values:
      - values/headlamp.yaml

  - name: bastion
    namespace: bastion
    chart: ../../charts/bastion
    needs:
      - gateway/gateway
      - local-path-provisioner/local-path-provisioner
    values:
      - values/lab.yaml.gotmpl

  - name: oauth2-proxy
    namespace: oauth2-proxy
    chart: oauth2-proxy/oauth2-proxy
    version: "10.7.4"
    postRenderer: domain-render
    postRendererArgs: [oauth2-proxy]
    needs:
      - dex/dex
      - bastion/bastion
      - headlamp/headlamp
    values:
      - values/oauth2-proxy.yaml
      - podAnnotations:
          checksum/browser-router: '{{ readFile "values/oauth2-proxy.yaml" | sha256sum }}'
          checksum/domain-config: '{{ readFile "domains/oauth2-proxy/job.py" | sha256sum }}'

  - name: gateway
    namespace: gateway
    chart: ../../charts/gateway
    wait: false
    needs:
      - agent-router/agent-router
    values:
      - values/lab.yaml.gotmpl
    hooks:
      - events: [postsync]
        command: kubectl
        args: [-n, gateway, wait, gateway/ai-inference-basics, --for=condition=Programmed, --timeout=180s]

{{- range $model := list "qwen3-0-6b" "qwen3-embedding-0-6b" "qwen3-reranker-0-6b" }}
  - name: {{ $model }}
    namespace: {{ $model }}
    chart: ../../charts/{{ $model }}
    wait: false
    timeout: 3600
    needs:
      - kserve/kserve
      - rustfs/rustfs
      - gateway/gateway
    values:
      - values/lab.yaml.gotmpl
{{- if env "LAB_MODEL_REPLICAS" }}
      - serving:
          replicas: {{ env "LAB_MODEL_REPLICAS" }}
{{- end }}
    hooks:
      - events: [postsync]
        showlogs: true
        command: timeout
        args:
          - "1200"
          - bash
          - files/check-model.sh
          - {{ $model }}
{{- end }}
