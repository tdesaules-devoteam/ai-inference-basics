[Unit]
Description=Make configured application images available before Helmfile bootstrap
ConditionVirtualization=vm
Requires=platform-k0s-ready.service
After=platform-k0s-ready.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin
Environment=INFRA_DEFINITION=/etc/ai-inference-basics/infra/infra-definition.devenv.json
# A retained Ready node condition can precede the new containerd process.
ExecStartPre=/usr/bin/timeout 180 /usr/bin/bash -ec 'until k0s ctr version >/dev/null 2>&1; do sleep 2; done'
ExecStart=/usr/bin/bash -ec '\
  images=$$(jq -er ".images.bastion, .images.provision" "$${INFRA_DEFINITION}"); \
  while IFS= read -r image; do \
    case "$$image" in \
      localhost/*) \
        echo "Waiting for imported application image: $$image"; \
        until k0s ctr images ls -q | grep -Fxq -- "$$image"; do sleep 5; done ;; \
      *) k0s ctr images pull "$$image" ;; \
    esac; \
  done <<< "$$images"; \
  echo "Configured application images are available."'
