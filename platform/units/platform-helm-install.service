[Unit]
Description=Install verified Helm 4.3.2
ConditionVirtualization=vm
Wants=network-online.target
Requires=platform-curl-install.service
After=network-online.target run-topgrade.service platform-curl-install.service

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateTmp=yes
TimeoutStartSec=600
ExecCondition=/usr/bin/bash -ec 'if command -v rpm-ostree >/dev/null; then rpm-ostree status --json | jq -e ".deployments[0].booted == true" >/dev/null; fi'
ExecCondition=/usr/bin/bash -ec '! echo "876242ea89b1fc07692e179d9abdc47028979fb64b20d85448e85193c8b04931  /usr/local/bin/helm" | sha256sum --check --status 2>/dev/null'
ExecStart=/usr/bin/curl --fail --location --retry 3 --connect-timeout 20 --max-time 500 --output /tmp/helm.tar.gz https://get.helm.sh/helm-v4.3.2-linux-amd64.tar.gz
ExecStart=/usr/bin/bash -ec 'echo "d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983  /tmp/helm.tar.gz" | sha256sum --check -'
ExecStart=/usr/bin/tar -xzf /tmp/helm.tar.gz -C /tmp linux-amd64/helm
ExecStart=/usr/bin/install -D -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm
ExecStart=/usr/bin/bash -ec 'echo "876242ea89b1fc07692e179d9abdc47028979fb64b20d85448e85193c8b04931  /usr/local/bin/helm" | sha256sum --check -'
ExecStart=/usr/bin/rm -rf /tmp/helm.tar.gz /tmp/linux-amd64

[Install]
WantedBy=multi-user.target
