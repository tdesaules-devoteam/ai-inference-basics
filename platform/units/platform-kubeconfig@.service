[Unit]
Description=Create the k0s administrator kubeconfig for %i
ConditionVirtualization=vm
Requires=platform-k0s-install.service
After=platform-k0s-install.service

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateTmp=yes
UMask=0077
TimeoutStartSec=360
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin
Environment=PLATFORM_USER=%i
ExecCondition=/usr/bin/test -f /var/lib/k0s-install/initialized
ExecStart=/usr/bin/timeout 300 /usr/bin/bash -ec 'until env -u KUBECONFIG k0s kubectl get --raw=/readyz --request-timeout=5s >/dev/null 2>&1; do sleep 3; done'
ExecStart=/usr/bin/bash -euc '\
    set -o pipefail; \
    home=$$(getent passwd "$${PLATFORM_USER}" | cut -d: -f6); \
    test -n "$${home}" && test -d "$${home}"; \
    if [[ -e "$${home}/.kube/config" || -L "$${home}/.kube/config" ]]; then \
        echo "Existing user kubeconfig preserved"; exit 0; \
    fi; \
    uid=$$(id -u "$${PLATFORM_USER}"); \
    gid=$$(id -g "$${PLATFORM_USER}"); \
    install -d -m 0700 -o "$${uid}" -g "$${gid}" "$${home}/.kube"; \
    temporary=$$(mktemp "$${home}/.kube/.config.XXXXXX"); \
    cleanup() { rm -f -- "$${temporary}"; }; \
    trap cleanup EXIT; \
    env -u KUBECONFIG k0s kubeconfig admin > "$${temporary}"; \
    test -s "$${temporary}"; \
    chmod 0600 "$${temporary}"; \
    chown "$${uid}:$${gid}" "$${temporary}"; \
    mv -T -n -- "$${temporary}" "$${home}/.kube/config"; \
    echo "User kubeconfig created"'

[Install]
WantedBy=multi-user.target
