[Unit]
Description=Prepare checksum-verified Helm chart sources
ConditionVirtualization=vm
Requires=platform-curl-install.service
After=network-online.target run-topgrade.service platform-curl-install.service
PartOf=platform-k0s-bootstrap.service

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateTmp=yes
UMask=0077
TimeoutStartSec=1200
Environment=PLATFORM_ARTIFACTS=/var/lib/ai-inference-basics/platform/artifacts
ExecCondition=/usr/bin/bash -ec 'if command -v rpm-ostree >/dev/null; then rpm-ostree status --json | jq -e ".deployments[0].booted == true" >/dev/null; fi'
ExecStart=/usr/bin/install -d -m 0700 /var/lib/ai-inference-basics/platform/artifacts
ExecStart=/usr/bin/bash -euc '\
    temporary=$$(mktemp -d); \
    trap "rm -rf -- $${temporary}" EXIT; \
    fetch() { \
        checksum=$$1; filename=$$2; url=$$3; \
        target="$${PLATFORM_ARTIFACTS}/$${filename}"; \
        if ! echo "$${checksum}  $${target}" | sha256sum --check --status 2>/dev/null; then \
            curl --fail --location --silent --show-error --connect-timeout 20 --max-time 500 --retry 3 --output "$${temporary}/$${filename}" "$${url}"; \
            echo "$${checksum}  $${temporary}/$${filename}" | sha256sum --check --status; \
            install -m 0644 "$${temporary}/$${filename}" "$${target}"; \
        fi; \
    }; \
    fetch 3602edf85bb1513d463073917adc930752177d034e1f944fb8f7610c779a34f6 local-path-provisioner-v0.0.37.tar.gz https://github.com/rancher/local-path-provisioner/archive/refs/tags/v0.0.37.tar.gz; \
    fetch 9b074f7a2d2143246b3e2ef9908c6791bbf05009766294a20e5a558bb44a6d96 rustfs-1.0.5.tgz https://charts.rustfs.com/rustfs-1.0.5.tgz; \
    tar -xzf "$${PLATFORM_ARTIFACTS}/local-path-provisioner-v0.0.37.tar.gz" -C "$${temporary}" local-path-provisioner-0.0.37/deploy/chart/local-path-provisioner; \
    rm -rf -- "$${PLATFORM_ARTIFACTS}/local-path-provisioner-0.0.37"; \
    mv "$${temporary}/local-path-provisioner-0.0.37" "$${PLATFORM_ARTIFACTS}/"'
