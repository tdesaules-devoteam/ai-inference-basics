[Unit]
Description=Bootstrap the Kubernetes platform with Helmfile
ConditionVirtualization=vm
Wants=network-online.target
Requires=platform-helm-install.service platform-helmfile-install.service platform-kubectl-install.service platform-k0s-ready.service platform-images-ready.service
After=network-online.target platform-helm-install.service platform-helmfile-install.service platform-kubectl-install.service platform-k0s-ready.service platform-images-ready.service

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateTmp=yes
UMask=0077
RuntimeDirectory=platform-k0s-bootstrap
RuntimeDirectoryMode=0700
TimeoutStartSec=5400
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin
Environment=HELM_CACHE_HOME=/var/lib/ai-inference-basics/platform/helm/cache
Environment=HELM_CONFIG_HOME=/var/lib/ai-inference-basics/platform/helm/config
Environment=HELM_DATA_HOME=/var/lib/ai-inference-basics/platform/helm/data
Environment=INFRA_DEFINITION=/etc/ai-inference-basics/infra/infra-definition.devenv.json
Environment=KUBECONFIG=/run/platform-k0s-bootstrap/kubeconfig
WorkingDirectory=/etc/ai-inference-basics/platform/helmfile
# Preserve normal devenv provisioning and defer across its staged reboot.
ExecCondition=/usr/bin/test -f /var/lib/k0s-install/initialized
ExecCondition=/usr/bin/bash -ec 'if command -v rpm-ostree >/dev/null; then rpm-ostree status --json | jq -e ".deployments[0].booted == true" >/dev/null; fi'
ExecStart=/usr/bin/bash -ec 'k0s kubeconfig admin > "$${KUBECONFIG}"'
ExecStart=/usr/local/bin/helmfile --file /etc/ai-inference-basics/platform/helmfile/helmfile.yaml.gotmpl sync
ExecStart=/usr/local/bin/k0s kubectl -n rustfs wait job/rustfs-buckets --for=condition=Complete --timeout=300s
ExecStart=/usr/local/bin/k0s kubectl -n rustfs get pvc rustfs-data
ExecStart=/usr/local/bin/k0s kubectl -n gateway wait httproute/browser-root httproute/browser-terminal httproute/browser-code httproute/browser-headlamp httproute/browser-grafana httproute/browser-oauth2 httproute/browser-dex '--for=jsonpath={.status.parents[0].conditions[?(@.type=="ResolvedRefs")].status}=True' --timeout=180s
ExecStart=/usr/bin/bash /etc/ai-inference-basics/platform/helmfile/scripts/check-api-route.sh
ExecStart=/usr/bin/rm -f /run/platform-k0s-bootstrap/kubeconfig
ExecStopPost=/usr/bin/rm -f /run/platform-k0s-bootstrap/kubeconfig

[Install]
WantedBy=multi-user.target
