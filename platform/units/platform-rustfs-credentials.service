[Unit]
Description=Prepare the persistent RustFS root Secret
ConditionVirtualization=vm
Requires=platform-k0s-ready.service
After=platform-k0s-ready.service
PartOf=platform-k0s-bootstrap.service

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateTmp=yes
UMask=0077
TimeoutStartSec=120
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin
UnsetEnvironment=KUBECONFIG
ExecCondition=/usr/bin/test -f /var/lib/k0s-install/initialized
ExecStart=/usr/bin/bash -euc '\
    set -o pipefail; \
    k0s kubectl create namespace rustfs --dry-run=client -o yaml | k0s kubectl apply -f -; \
    existing=$$(k0s kubectl -n rustfs get secret rustfs-root --ignore-not-found -o name); \
    if [[ -z "$${existing}" ]]; then \
        credentials=$$(mktemp); \
        trap "rm -f -- $${credentials}" EXIT; \
        echo "RUSTFS_ACCESS_KEY=$$(openssl rand -hex 12)" > "$${credentials}"; \
        echo "RUSTFS_SECRET_KEY=$$(openssl rand -hex 32)" >> "$${credentials}"; \
        k0s kubectl -n rustfs create secret generic rustfs-root --from-env-file="$${credentials}"; \
    fi; \
    k0s kubectl -n rustfs get secret rustfs-root -o json | jq -e ".data.RUSTFS_ACCESS_KEY != null and .data.RUSTFS_SECRET_KEY != null" >/dev/null'
