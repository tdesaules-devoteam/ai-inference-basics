[Unit]
Description=Install verified Helmfile 1.8.5
ConditionVirtualization=vm
Wants=network-online.target
Requires=platform-curl-install.service
After=network-online.target run-topgrade.service platform-curl-install.service

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateTmp=yes
TimeoutStartSec=600
ExecCondition=/usr/bin/bash -ec 'if command -v rpm-ostree >/dev/null; then rpm-ostree status --json | jq -e ".deployments[0].booted == true" >/dev/null; fi'
ExecCondition=/usr/bin/bash -ec '! echo "953604c778d3b93f83187ff5064279b0ade68ecd1f5a227e63ac54138a4bd7d9  /usr/local/bin/helmfile" | sha256sum --check --status 2>/dev/null'
ExecStart=/usr/bin/curl --fail --location --retry 3 --connect-timeout 20 --max-time 500 --output /tmp/helmfile.tar.gz https://github.com/helmfile/helmfile/releases/download/v1.8.5/helmfile_1.8.5_linux_amd64.tar.gz
ExecStart=/usr/bin/bash -ec 'echo "e10344a4e6121689265c8fbe8ce96977b4722a9f953db862014a08b99938c333  /tmp/helmfile.tar.gz" | sha256sum --check -'
ExecStart=/usr/bin/tar -xzf /tmp/helmfile.tar.gz -C /tmp helmfile
ExecStart=/usr/bin/install -D -m 0755 /tmp/helmfile /usr/local/bin/helmfile
ExecStart=/usr/bin/bash -ec 'echo "953604c778d3b93f83187ff5064279b0ade68ecd1f5a227e63ac54138a4bd7d9  /usr/local/bin/helmfile" | sha256sum --check -'
ExecStart=/usr/bin/rm -f /tmp/helmfile.tar.gz /tmp/helmfile

[Install]
WantedBy=multi-user.target
