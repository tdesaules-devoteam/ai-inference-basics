[Unit]
Description=Install native single-node k0s
ConditionVirtualization=vm
ConditionPathExists=!/var/lib/k0s-install/initialized
Wants=network-online.target
Requires=platform-curl-install.service
After=network-online.target run-topgrade.service platform-curl-install.service

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateTmp=yes
TimeoutStartSec=600
ExecCondition=/usr/bin/bash -ec 'if command -v rpm-ostree >/dev/null; then rpm-ostree status --json | jq -e ".deployments[0].booted == true" >/dev/null; fi'
ExecStart=/usr/bin/install -d -m 0755 /usr/local/bin
ExecStart=/usr/bin/install -d -m 0700 /var/lib/k0s-install
ExecStart=/usr/bin/curl --fail --location --retry 3 --output /tmp/k0s.download https://github.com/k0sproject/k0s/releases/download/v1.37.2+k0s.1/k0s-v1.37.2+k0s.1-amd64
ExecStart=/usr/bin/bash -ec 'echo "4770cf89ff45e43292819f6e3a02a25a453bc750c777f6f7ad2de335f3f41df5  /tmp/k0s.download" | sha256sum --check -'
ExecStart=/usr/bin/bash -ec 'cmp -s /tmp/k0s.download /usr/local/bin/k0s || install -m 0755 /tmp/k0s.download /usr/local/bin/k0s'
ExecStart=/usr/local/bin/k0s config validate --config /etc/k0s/k0s.yaml
ExecStart=/usr/bin/bash -ec 'systemctl cat k0scontroller.service >/dev/null 2>&1 || /usr/local/bin/k0s install controller --single --config /etc/k0s/k0s.yaml'
ExecStart=/usr/bin/ln -sfn k0scontroller.service /etc/systemd/system/platform-k0s-controller.service
ExecStart=/usr/bin/systemctl daemon-reload
ExecStart=/usr/bin/systemctl enable --now k0scontroller
ExecStart=/usr/bin/rm -f /tmp/k0s.download
ExecStart=/usr/bin/touch /var/lib/k0s-install/initialized

[Install]
WantedBy=multi-user.target
