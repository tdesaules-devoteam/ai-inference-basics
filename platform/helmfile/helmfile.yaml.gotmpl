{{- $environment := .Environment.Name }}
{{- if eq $environment "default" }}
{{- $environment = "devenv" }}
{{- end }}
{{- $definition := env "INFRA_DEFINITION" | default (printf "../../infra/infra-definition.%s.json" $environment) }}
{{- $infra := exec "python3" (list "scripts/validate-infra.py" $definition "--emit") | fromJson }}
environments:
{{- range $name := list "default" "devenv" "scaleway" }}
  {{ $name }}:
    values:
      - infra:
{{ $infra | toYaml | indent 10 }}
{{- end }}
---
{{- $infra := .Values.infra }}
# Helmfile fetches upstream charts directly. OCI references are manifest-digest pinned.
repositories:
  - name: rustfs
    url: https://charts.rustfs.com
  - name: dex
    url: https://charts.dexidp.io
  - name: headlamp
    url: https://kubernetes-sigs.github.io/headlamp/
  - name: oauth2-proxy
    url: https://oauth2-proxy.github.io/manifests
  - name: hami
    url: https://project-hami.github.io/HAMi
  - name: nvidia
    url: https://helm.ngc.nvidia.com/nvidia
  - name: dcgm
    url: https://nvidia.github.io/dcgm-exporter/helm-charts

helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  createNamespace: true
  historyMax: 5

releases:
  - name: kyverno
    namespace: kyverno
    chart: oci://ghcr.io/kyverno/charts/kyverno@sha256:290ff54d4b7d015ce2ffe5be84b60e2db5a59d8c5dcea772a8f6e32475c2eba2
    values:
      - values/kyverno.yaml
    hooks:
      - events: [postsync]
        command: kubectl
        args: [wait, --for=condition=Established, crd/generatingpolicies.policies.kyverno.io, crd/mutatingpolicies.policies.kyverno.io, --timeout=180s]

  - name: local-path-provisioner
    namespace: local-path-provisioner
    # Upstream chart 0.0.37.
    chart: oci://ghcr.io/rancher/local-path-provisioner/charts/local-path-provisioner@sha256:81033683ce790e593524b2105945ee0d81bf6608f0c85eb5e0c1082cc74ff03d
    values:
      - values/local-path-provisioner.yaml

  - name: rustfs
    namespace: rustfs
    chart: rustfs/rustfs
    version: "1.0.6"
    needs:
      - local-path-provisioner/local-path-provisioner
      - kyverno/kyverno
    values:
      - values/rustfs.yaml
      - ../../infra/helmfile/lab.yaml.gotmpl
      - storageclass:
          dataStorageSize: {{ printf "%vGi" $infra.storage.modelsGiB }}

  - name: cert-manager
    namespace: cert-manager
    # Upstream chart v1.21.3.
    chart: oci://quay.io/jetstack/charts/cert-manager@sha256:e482675aec32862d323a9218293ff7de81192337998615e4378c56498473f240
    values:
      - values/cert-manager.yaml
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [wait, --for=condition=Established, crd/certificates.cert-manager.io, crd/issuers.cert-manager.io, --timeout=180s]

  - name: envoy-gateway
    namespace: envoy-gateway
    # Upstream chart v1.10.0.
    chart: oci://docker.io/envoyproxy/gateway-helm@sha256:dcb82a14c04b426615a71d97222c7edf9f5ff58b800d241e71ac5784ae6dc7b7
    values:
      - values/envoy-gateway.yaml
{{- if ne $infra.environment "devenv" }}
      - values/envoy-agent-router.yaml
{{- end }}
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [wait, --for=condition=Established, crd/gatewayclasses.gateway.networking.k8s.io, crd/gateways.gateway.networking.k8s.io, crd/httproutes.gateway.networking.k8s.io, crd/backends.gateway.envoyproxy.io, --timeout=180s]

{{- if ne $infra.environment "devenv" }}
  - name: agent-router-crds
    namespace: agent-router
    # Upstream chart v1.2.1; product renamed, upstream artifact names unchanged.
    chart: oci://docker.io/envoyproxy/ai-gateway-crds-helm@sha256:03a81d91fc93a2b47b03779f71b7e2b2180dccfdf6561d2fbccafc598125aa80
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [wait, --for=condition=Established, crd/aigatewayroutes.aigateway.envoyproxy.io, crd/aiservicebackends.aigateway.envoyproxy.io, --timeout=180s]

  - name: agent-router
    namespace: agent-router
    chart: oci://docker.io/envoyproxy/ai-gateway-helm@sha256:a78d01521215b0a3fe9fe2ab3eaa35991e6b571fe00969765a0abce3ca3b9dde
    needs:
      - cert-manager/cert-manager
      - envoy-gateway/envoy-gateway
      - agent-router/agent-router-crds
    values:
      - values/agent-router.yaml
    hooks:
      - events: [postsync]
        showlogs: true
        command: kubectl
        args: [-n, agent-router, wait, --for=condition=Ready, certificate/self-signed-cert-for-mutating-webhook, --timeout=180s]
      - events: [postsync]
        showlogs: true
        command: timeout
        args:
          - "180"
          - bash
          - -ec
          - 'until test -n "$(kubectl get mutatingwebhookconfiguration envoy-ai-gateway-gateway-pod-mutator.agent-router -o jsonpath="{.webhooks[0].clientConfig.caBundle}")"; do sleep 2; done'

{{- end }}
  - name: kserve-crds
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-crd-minimal@sha256:62362337168d1675b8dc90a846dc9cd51af944f59160a42fc387755aca2fbfec
    hooks:
      - events: [postsync]
        command: kubectl
        args: [wait, --for=condition=Established, crd/inferenceservices.serving.kserve.io, crd/servingruntimes.serving.kserve.io, --timeout=180s]
  - name: kserve
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-resources@sha256:2d189c8c9d51e1ad658f9a973eaf9ea73b251305e7f93507adb1b559303f1e9a
    needs:
      - kserve/kserve-crds
      - cert-manager/cert-manager
    values:
      - values/kserve.yaml

  - name: dex-config
    namespace: dex
    chart: ../../charts/dex-config
    needs:
      - gateway/gateway
    values:
      - ../../infra/helmfile/lab.yaml.gotmpl
      - access:
          adminEmail: {{ $infra.access.adminEmail | quote }}
          adminPassword: {{ $infra.access.adminPassword | quote }}

  - name: loki
    namespace: loki
    chart: oci://ghcr.io/grafana/helm-charts/loki@sha256:8d708161a019689e331fd04769e2b4232d01fbb7f627551bd63d6b89438a3aba
    needs:
      - rustfs/rustfs
    values:
      - values/loki.yaml

  - name: tempo
    namespace: tempo
    chart: oci://ghcr.io/grafana-community/helm-charts/tempo@sha256:7cf66b47c9b6693900b8886d9accf296d57e5a226164d236f043ada17ff54844
    needs:
      - rustfs/rustfs
    values:
      - values/tempo.yaml

  - name: mimir
    namespace: mimir
    chart: oci://ghcr.io/grafana/helm-charts/mimir-distributed@sha256:45107a5f1a17f080791834fb1e90d9d5d6b32802506ca9960e6103001bcacf4b
    needs:
      - rustfs/rustfs
    values:
      - values/mimir.yaml

  - name: otel-node
    namespace: opentelemetry-collector
    chart: oci://ghcr.io/open-telemetry/opentelemetry-helm-charts/opentelemetry-collector@sha256:09b3563b7b35dab243a642ceb9cb459ad23e76b559fcdfe778fbfdb6e6967c06
    needs:
      - loki/loki
      - mimir/mimir
    values:
      - values/otel-node.yaml

  - name: otel-cluster
    namespace: opentelemetry-collector
    chart: oci://ghcr.io/open-telemetry/opentelemetry-helm-charts/opentelemetry-collector@sha256:09b3563b7b35dab243a642ceb9cb459ad23e76b559fcdfe778fbfdb6e6967c06
    needs:
      - loki/loki
      - mimir/mimir
      - tempo/tempo
      - envoy-gateway/envoy-gateway
    values:
      - values/otel-cluster.yaml

  - name: grafana
    namespace: grafana
    chart: oci://ghcr.io/grafana-community/helm-charts/grafana@sha256:d67763577c04eafaaa11601a322a960ad91bfad49d49621e6b5cac9a1c894140
    needs:
      - dex/dex
      - loki/loki
      - tempo/tempo
      - mimir/mimir
    values:
      - values/grafana.yaml
      - ../../infra/helmfile/lab.yaml.gotmpl
      - adminEmail: {{ $infra.access.adminEmail | quote }}

  - name: dex
    namespace: dex
    chart: dex/dex
    version: "0.26.0"
    needs:
      - dex/dex-config
    values:
      - values/dex.yaml
      - podAnnotations:
          checksum/domain-config: '{{ printf "%s%s%s%s" (ternary "http" "https" (eq $infra.environment "devenv")) (readFile "../../charts/dex-config/files/configure.py") (toJson $infra.access) (toJson $infra.network) | sha256sum }}'

  - name: headlamp
    namespace: headlamp
    chart: headlamp/headlamp
    version: "0.46.0"
    needs:
      - gateway/gateway
    values:
      - values/headlamp.yaml

  - name: bastion
    namespace: bastion
    chart: ../../charts/bastion
    needs:
      - gateway/gateway
      - local-path-provisioner/local-path-provisioner
    values:
      - ../../infra/helmfile/lab.yaml.gotmpl

  - name: requester
    namespace: requester
    chart: ../../charts/requester
    needs:
      - gateway/gateway
    values:
      - ../../infra/helmfile/lab.yaml.gotmpl

  - name: oauth2-proxy
    namespace: oauth2-proxy
    chart: oauth2-proxy/oauth2-proxy
    version: "10.7.4"
    needs:
      - dex/dex
      - bastion/bastion
      - headlamp/headlamp
      - grafana/grafana
      - requester/requester
    values:
      - values/oauth2-proxy.yaml
      - ../../infra/helmfile/lab.yaml.gotmpl
{{- if eq $infra.environment "devenv" }}
      - config:
          cookieName: _lab_http_session
{{- end }}
      - podAnnotations:
          checksum/browser-router: '{{ readFile "values/oauth2-proxy.yaml" | sha256sum }}'

  - name: gateway
    namespace: gateway
    chart: ../../charts/gateway
    wait: false
    needs:
{{- if eq $infra.environment "devenv" }}
      - envoy-gateway/envoy-gateway
      - cert-manager/cert-manager
{{- else }}
      - agent-router/agent-router
{{- end }}
      - kyverno/kyverno
      - opentelemetry-collector/otel-cluster
    values:
      - ../../infra/helmfile/lab.yaml.gotmpl
      - apiBearerToken: {{ $infra.access.apiBearerToken | quote }}
    hooks:
      - events: [postsync]
        command: kubectl
        args: [-n, gateway, wait, gateway/ai-inference-basics, --for=condition=Programmed, --timeout=180s]

{{- if eq $infra.environment "devenv" }}
{{- $serving := dict }}
{{- range $name, $settings := $infra.models }}
{{- if $settings.enabled }}
{{- $_ := set $serving $name (dict "replicas" $settings.replicas "task" (readFile (printf "../../charts/%s/values.yaml" $name) | fromYaml).task) }}
{{- end }}
{{- end }}
{{- $contract := exec "python3" (list "scripts/model-contract.py" "render" (printf "http://%s:%v" $infra.network.hostname $infra.network.apiNodePort) (toJson $serving)) | fromJson }}
  - name: agentgateway-config
    namespace: agentgateway
    chart: ../../charts/agentgateway-config
    needs:
      - gateway/gateway
    values:
      - ../../infra/helmfile/lab.yaml.gotmpl
  - name: agentgateway
    namespace: agentgateway
    chart: oci://cr.agentgateway.dev/charts/agentgateway-standalone@sha256:f8e74f989c6705e3e1aaaaabacf554d594e2a24867eb4097b216e019a88c14a6
    needs:
      - agentgateway/agentgateway-config
    values:
      - values/agentgateway.yaml
      - config:
          binds:
            - port: 8080
              listeners:
                - name: model-api
                  protocol: HTTP
                  policies:
                    cors:
                      allowOrigins:
                        - {{ printf "http://%s:%v" $infra.network.hostname $infra.network.httpsNodePort | quote }}
                      allowMethods:
                        - GET
                        - POST
                      allowHeaders:
                        - authorization
                        - content-type
                  routes:
{{- range $name, $body := dict "openapi" $contract.spec "models" $contract.catalog }}
                    - name: {{ $name }}
                      hostnames: &discoveryHosts{{ $name }}
                        - {{ $infra.network.hostname | quote }}
                        - agentgateway.agentgateway.svc.cluster.local
                      matches:
{{- range $method := list "GET" "OPTIONS" }}
                        - method: {{ $method }}
                          path:
                            exact: {{ ternary "/openapi.json" "/v1/models" (eq $name "openapi") }}
{{- end }}
                      policies:
{{- if eq $name "models" }}
                        apiKey: &modelAuth
                          mode: strict
                          keys:
                            - keyHash: sha256:{{ $infra.access.apiBearerToken | sha256sum }}
{{- end }}
                        directResponse:
                          status: 200
                          headers:
                            content-type: "'application/json'"
                          # Keep JSON Schema $ref keys literal through agentgateway's environment expansion.
                          body: {{ $body | toJson | replace "$" "\\u0024" | quote }}
{{- end }}
{{- range $op := $contract.operations }}
                    - name: {{ $op.name }}
                      hostnames: *discoveryHostsmodels
                      matches:
{{- range $method := list "POST" "OPTIONS" }}
                        - method: {{ $method }}
                          path:
                            exact: {{ $op.path }}
{{- end }}
                      policies:
                        apiKey: *modelAuth
{{- if eq $op.format "http" }}
                      backends:
                        - host: {{ $op.model }}-predictor.{{ $op.model }}.svc.cluster.local:80
                          policies:
                            requestHeaderModifier:
                              remove:
                                - authorization
{{- else }}
                        ai:
                          routes:
                            {{ $op.path }}: {{ $op.format }}
                      backends:
                        - ai:
                            name: {{ $op.model }}
                            hostOverride: {{ $op.model }}-predictor.{{ $op.model }}.svc.cluster.local:80
                            provider:
                              custom:
                                formats:
                                  - type: {{ $op.format }}
                                    path: {{ $op.path }}
                            policies:
                              requestHeaderModifier:
                                remove:
                                  - authorization
{{- end }}
{{- end }}
{{- end }}
  - name: gpu-operator
    namespace: gpu-operator
    chart: nvidia/gpu-operator
    version: v26.7.3
    values:
      - values/gpu-operator.yaml

  - name: hami
    namespace: hami
    chart: hami/hami
    version: "2.11.0"
    needs:
      - cert-manager/cert-manager
      - gpu-operator/gpu-operator
    values:
      - values/hami.yaml

  - name: dcgm-exporter
    namespace: dcgm-exporter
    chart: dcgm/dcgm-exporter
    version: "4.9.0"
    needs:
      - gpu-operator/gpu-operator
    values:
      - values/dcgm-exporter.yaml

{{/* Chain only enabled models: parallel cold imports can exhaust the single node and RustFS. */}}
{{- $previousModel := "" }}
{{- range $model, $settings := $infra.models }}
{{- $native := (readFile (printf "../../charts/%s/values.yaml" $model) | fromYaml).nativeContextTokens }}
  - name: {{ $model }}
    namespace: {{ $model }}
    chart: ../../charts/{{ $model }}
    installed: {{ $settings.enabled }}
    wait: false
    timeout: 3600
    needs:
      - kserve/kserve
      - rustfs/rustfs
      - gateway/gateway
      - oauth2-proxy/oauth2-proxy
{{- if eq $infra.environment "devenv" }}
      - agentgateway/agentgateway
{{- end }}
{{- if and $settings.enabled $previousModel }}
      - {{ $previousModel }}/{{ $previousModel }}
{{- end }}
{{- if eq $infra.environment "scaleway" }}
      - hami/hami
{{- end }}
    values:
      - ../../infra/helmfile/lab.yaml.gotmpl
      - serving:
          replicas: {{ $settings.replicas }}
        import:
          enabled: {{ $settings.import }}
        maxModelLen: {{ int $native }}
{{- if $settings.enabled }}
    hooks:
      - events: [postsync]
        showlogs: true
        command: timeout
        args:
          - "1200"
          - bash
          - scripts/check-model.sh
          - {{ $model }}
{{- $previousModel = $model }}
{{- end }}
{{- end }}
