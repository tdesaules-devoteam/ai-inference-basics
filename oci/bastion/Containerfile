FROM quay.io/fedora/fedora-minimal:45@sha256:0b176d28a1621343b4199c0eb5de6394e13cc873f094f4bcf385b21bc10b0416 AS tools
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN microdnf install -y tar-1.35-10.fc45 gzip-1.14-4.fc45 && microdnf clean all
COPY oci/bastion/tools.lock /tmp/tools.lock
WORKDIR /tmp
RUN mkdir -p /tools /opt/code-server && \
    while read -r sha name url; do \
      [[ -z "$sha" || "$sha" == \#* ]] && continue; \
      curl -fLsS --retry 3 "$url" -o "$name" && echo "$sha  $name" | sha256sum -c - || exit 1; \
    done < tools.lock && \
    install -m 0755 kubectl /tools/kubectl && \
    tar -xzf k9s.tar.gz -C /tools k9s && tar -xzf zellij.tar.gz -C /tools zellij && \
    tar -xzf starship.tar.gz -C /tools starship && \
    tar -xzf uv.tar.gz --strip-components=1 -C /tools uv-x86_64-unknown-linux-gnu/uv && \
    tar -xzf code-server.tar.gz --strip-components=1 -C /opt/code-server

FROM quay.io/fedora/fedora-minimal:45@sha256:0b176d28a1621343b4199c0eb5de6394e13cc873f094f4bcf385b21bc10b0416 AS python
RUN microdnf install -y python3.12-3.12.16-2.fc45 libgomp-16.2.1-3.fc45 numactl-libs-2.0.19-5.fc45 && microdnf clean all
COPY --from=tools /tools/uv /usr/local/bin/uv
COPY oci/bastion/requirements.lock /tmp/requirements.lock
RUN uv venv --python /usr/bin/python3.12 /opt/venv && \
    uv pip install --python /opt/venv/bin/python --require-hashes --torch-backend cpu -r /tmp/requirements.lock && \
    uv cache clean

FROM quay.io/fedora/fedora-minimal:45@sha256:0b176d28a1621343b4199c0eb5de6394e13cc873f094f4bcf385b21bc10b0416 AS runtime
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
LABEL org.opencontainers.image.source="https://github.com/tdesaules-devoteam/ai-inference-basics" \
      org.opencontainers.image.title="AI Inference Basics participant bastion"
RUN microdnf install -y --setopt=install_weak_deps=0 \
      bash-5.3.15-2.fc45 jq-1.8.2-5.fc45 curl-8.21.0-9.fc45 git-core-2.56.1-1.fc45 ca-certificates-2026.2.92_v9.0.319-2.fc45 libgcc-16.2.1-3.fc45 libstdc++-16.2.1-3.fc45 openssl-libs-4.0.3-1.fc45 ncurses-term-6.6-3.fc45 \
      python3.12-3.12.16-2.fc45 libgomp-16.2.1-3.fc45 numactl-libs-2.0.19-5.fc45 \
      ttyd-1.7.7-11.fc45 helix-25.07.1-13.fc45 && microdnf clean all && \
    mkdir -p /workspace /usr/share/ai-inference-basics && chown 1000:1000 /workspace && \
    echo 'lab:x:1000:1000:Lab participant:/workspace:/bin/bash' >> /etc/passwd && \
    echo 'lab:x:1000:' >> /etc/group && \
    rpm -qa | sort > /usr/share/ai-inference-basics/rpms.txt
COPY --from=tools /tools/ /usr/local/bin/
COPY --from=tools /opt/code-server /opt/code-server
COPY --from=python /opt/venv /opt/venv
COPY oci/bastion/entrypoint.sh /usr/local/bin/workspace-entrypoint
COPY oci/bastion/bashrc /etc/lab-bashrc
COPY oci/bastion/zellij.kdl /etc/zellij/config.kdl
RUN ln -s /opt/code-server/bin/code-server /usr/local/bin/code-server
COPY oci/bastion/ui-assets.lock /usr/share/ai-inference-basics/ui-assets.lock
COPY oci/bastion/prepare_ui.py /tmp/prepare_ui.py
RUN python3.12 /tmp/prepare_ui.py && rm /tmp/prepare_ui.py
ENV HOME=/workspace TERM=xterm-256color SHELL=/bin/bash XDG_RUNTIME_DIR=/workspace/.run \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1 SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
USER 1000:1000
WORKDIR /workspace
EXPOSE 7681 8080
ENTRYPOINT ["bash", "/usr/local/bin/workspace-entrypoint"]
