FROM quay.io/fedora/fedora-minimal:45 AS tools
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN microdnf install -y tar-1.35-10.fc45 gzip-1.14-4.fc45 && microdnf clean all
RUN curl -fLsS --retry 3 https://github.com/astral-sh/uv/releases/download/0.13.10/uv-x86_64-unknown-linux-gnu.tar.gz -o /tmp/uv.tar.gz && \
    echo 'bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c  /tmp/uv.tar.gz' | sha256sum -c - && \
    tar -xzf /tmp/uv.tar.gz -C /tmp --strip-components=1 && \
    curl -fLsS --retry 3 https://github.com/rustfs/cli/releases/download/v0.1.38/rustfs-cli-linux-amd64-v0.1.38.tar.gz -o /tmp/rc.tar.gz && \
    echo '9741028f46f5f5a152da1e3257980e9c7be2714c21b5b14a8bb5ac7d93f882e9  /tmp/rc.tar.gz' | sha256sum -c - && \
    tar -xzf /tmp/rc.tar.gz -C /tmp rc && \
    curl -fLsS --retry 3 https://dl.k8s.io/release/v1.37.3/bin/linux/amd64/kubectl -o /tmp/kubectl && \
    echo '9a1b55af2795b25dd288dbef62387db9b5530087ab918d28c6ad067f2e3cb07c  /tmp/kubectl' | sha256sum -c - && \
    chmod 0755 /tmp/kubectl

FROM quay.io/fedora/fedora-minimal:45 AS python
RUN microdnf install -y python3.12-3.12.16-2.fc45 && microdnf clean all
COPY --from=tools /tmp/uv /usr/local/bin/uv
COPY oci/provision/requirements.lock /tmp/requirements.lock
RUN uv venv --python /usr/bin/python3.12 /opt/venv && \
    uv pip install --python /opt/venv/bin/python --require-hashes -r /tmp/requirements.lock && uv cache clean

FROM quay.io/fedora/fedora-minimal:45
LABEL org.opencontainers.image.source="https://github.com/tdesaules-devoteam/ai-inference-basics" \
      org.opencontainers.image.title="AI Inference Basics provisioning tools"
RUN microdnf install -y python3.12-3.12.16-2.fc45 ca-certificates-2026.2.92_v9.0.319-2.fc45 libgcc-16.2.1-3.fc45 libstdc++-16.2.1-3.fc45 && microdnf clean all && \
    mkdir -p /workspace && chown 1000:1000 /workspace
COPY --from=tools /tmp/rc /usr/local/bin/rc
COPY --from=tools /tmp/kubectl /usr/local/bin/kubectl
COPY --from=python /opt/venv /opt/venv
ENV HOME=/workspace PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt HF_HUB_DISABLE_TELEMETRY=1
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["python3"]
