FROM quay.io/fedora/fedora-minimal@sha256:f58854409553b5bf2cb53c6f3b82349e0c9d55ed64943a6fb6b379f4a845de62
LABEL org.opencontainers.image.source="https://github.com/tdesaules-devoteam/ai-inference-basics" \
      org.opencontainers.image.title="LFM3-Omni-2B Transformers runtime"
RUN microdnf install -y --setopt=install_weak_deps=0 \
      python3.12-3.12.16-2.fc45 ca-certificates libgomp libsndfile ffmpeg-free && microdnf clean all && \
    echo 'inference:x:1000:1000:Inference runtime:/tmp:/sbin/nologin' >> /etc/passwd && \
    echo 'inference:x:1000:' >> /etc/group
ARG REQUIREMENTS_LOCK=requirements.lock
ARG TORCH_BACKEND=cpu
COPY oci/lfm3-omni-2b-transformers/${REQUIREMENTS_LOCK} /tmp/requirements.lock
# Install in the final filesystem: avoid copying multi-GiB CUDA wheels across stages.
# The verified installer and its cache are removed in the same layer.
RUN python3.12 -c 'import hashlib, tarfile, urllib.request; urllib.request.urlretrieve("https://github.com/astral-sh/uv/releases/download/0.13.8/uv-x86_64-unknown-linux-gnu.tar.gz", "/tmp/uv.tar.gz"); assert hashlib.sha256(open("/tmp/uv.tar.gz", "rb").read()).hexdigest() == "5acfd9177cfecf0bf87578f059728215ccc884388988f55f7a65041b57387d91"; tarfile.open("/tmp/uv.tar.gz").extractall("/tmp/uv-tools", filter="data")' && \
    /tmp/uv-tools/uv-x86_64-unknown-linux-gnu/uv venv --python /usr/bin/python3.12 /opt/venv && \
    if [ "$TORCH_BACKEND" = cpu ]; then \
      /tmp/uv-tools/uv-x86_64-unknown-linux-gnu/uv pip install --cache-dir /tmp/uv-cache --python /opt/venv/bin/python --require-hashes --torch-backend cpu -r /tmp/requirements.lock; \
    else \
      /tmp/uv-tools/uv-x86_64-unknown-linux-gnu/uv pip install --cache-dir /tmp/uv-cache --python /opt/venv/bin/python --require-hashes --index-strategy unsafe-best-match -r /tmp/requirements.lock; \
    fi && rm -rf /tmp/uv-tools /tmp/uv-cache /tmp/uv.tar.gz /tmp/requirements.lock
COPY oci/lfm3-omni-2b-transformers/server.py /app/server.py
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin HOME=/tmp HF_HOME=/tmp/huggingface \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt OMP_NUM_THREADS=8
USER 1000:1000
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--limit-concurrency", "8"]
