{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["gateway", "access", "api"],
  "properties": {
    "models": {
      "type": "object",
      "required": ["enabled", "image", "hardware", "maxModelLen"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hardware": {"enum": ["cpu", "gpu"]},
        "maxModelLen": {"type": "integer", "minimum": 128, "maximum": 4096},
        "image": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
        "chat": {"$ref": "#/definitions/model"},
        "embeddings": {"$ref": "#/definitions/model"},
        "rerank": {"$ref": "#/definitions/model"}
      }
    },
    "workspaces": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "participants": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["a", "b"]}}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"image": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"}}, "required": ["image"]}
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "hostname", "envoyImage", "nodePort", "tlsSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hostname": {"type": "string", "minLength": 1},
        "envoyImage": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
        "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767},
        "tlsSecret": {"type": "string", "minLength": 1}
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "oauthImage": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
        "existingSecret": {"type": "string", "minLength": 1}
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string", "minLength": 1},
        "backendPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  },
  "definitions": {
    "model": {
      "type": "object",
      "required": ["checkpoint", "revision"],
      "properties": {
        "checkpoint": {"type": "string", "pattern": "^Qwen/Qwen3-"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    }
  }
}
