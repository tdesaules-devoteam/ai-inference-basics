FROM quay.io/fedora/fedora@sha256:b68e9c913030593d87875f7b6441b3d8a909aa434579a10dc7dea255a8d7d894 AS builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN dnf install -y golang-1.27.4-2.fc45 && dnf clean all
COPY main.go /src/main.go
RUN CGO_ENABLED=0 go build -trimpath -o /operation /src/main.go
RUN curl -fL https://get.helm.sh/helm-v4.3.1-linux-amd64.tar.gz -o /helm.tgz \
 && echo '0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b  /helm.tgz' | sha256sum -c - \
 && tar -xzf /helm.tgz -C /
RUN curl -fsSL https://github.com/helmfile/helmfile/releases/download/v1.8.3/helmfile_1.8.3_linux_amd64.tar.gz -o /helmfile.tgz \
 && echo '7d79c6d2099a4819213873164eda23bdbd32f1404fec7a7104d934e5d102596f  /helmfile.tgz' | sha256sum -c - \
 && tar -xzf /helmfile.tgz -C / helmfile
RUN curl -fsSL https://github.com/kyverno/kyverno/releases/download/v1.20.0/kyverno-cli_v1.20.0_linux_x86_64.tar.gz -o /kyverno.tgz \
 && echo '06b8f3ca7b5626473be8fb4d343ad54ab84e317142766f72420e7d44b80942e2  /kyverno.tgz' | sha256sum -c - \
 && tar -xzf /kyverno.tgz -C / kyverno
FROM quay.io/fedora/fedora@sha256:b68e9c913030593d87875f7b6441b3d8a909aa434579a10dc7dea255a8d7d894 AS runtime
RUN dnf install -y python3-pyyaml-6.0.3-6.fc45 python3-jsonschema-4.26.0-10.fc45 python3-bcrypt-4.3.0-16.fc45 && dnf clean all
COPY --from=builder /helmfile /usr/local/bin/helmfile
COPY --from=builder /kyverno /usr/local/bin/kyverno
COPY --from=builder /linux-amd64/helm /usr/local/bin/helm
COPY --from=builder /operation /operation
ENTRYPOINT ["/operation"]
