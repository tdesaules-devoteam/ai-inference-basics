FROM quay.io/fedora/fedora@sha256:b68e9c913030593d87875f7b6441b3d8a909aa434579a10dc7dea255a8d7d894 AS builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN dnf install -y golang-1.27.3-1.fc45 unzip-6.0-71.fc45 && dnf clean all
COPY main.go /src/main.go
RUN CGO_ENABLED=0 go build -trimpath -o /operation /src/main.go
RUN curl -fL https://releases.hashicorp.com/terraform/1.17.2/terraform_1.17.2_linux_amd64.zip -o /terraform.zip \
 && echo 'e6f16b2f0b137ee5729caa8c4e79a3bae4ee261acd198a1fcfa8584a6296605b  /terraform.zip' | sha256sum -c - \
 && unzip /terraform.zip terraform -d /out
FROM quay.io/fedora/fedora@sha256:b68e9c913030593d87875f7b6441b3d8a909aa434579a10dc7dea255a8d7d894 AS runtime
COPY --from=builder /out/terraform /usr/local/bin/terraform
COPY --from=builder /operation /operation
ENTRYPOINT ["/operation"]
