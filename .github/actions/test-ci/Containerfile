FROM quay.io/fedora/fedora@sha256:f236063d5a7a15e76ff034f2be5fa6f7a8922fcb655093ad972a1f196b14a007 AS builder
RUN dnf install -y golang-1.27.4-2.fc45 && dnf clean all
COPY main.go /src/main.go
RUN CGO_ENABLED=0 go build -trimpath -o /operation /src/main.go
FROM builder AS runtime
RUN dnf install -y python3-3.15.2-1.fc45 git-core-2.56.1-1.fc45 && dnf clean all
ENTRYPOINT ["/operation"]
