FROM quay.io/fedora/fedora@sha256:b68e9c913030593d87875f7b6441b3d8a909aa434579a10dc7dea255a8d7d894 AS builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN dnf install -y golang-1.27.3-1.fc45 && dnf clean all
COPY main.go /src/main.go
RUN CGO_ENABLED=0 go build -trimpath -o /operation /src/main.go
RUN curl -fL https://get.helm.sh/helm-v4.3.1-linux-amd64.tar.gz -o /helm.tgz \
 && echo '0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b  /helm.tgz' | sha256sum -c - \
 && tar -xzf /helm.tgz -C /
FROM quay.io/fedora/fedora@sha256:b68e9c913030593d87875f7b6441b3d8a909aa434579a10dc7dea255a8d7d894 AS runtime
COPY --from=builder /linux-amd64/helm /usr/local/bin/helm
COPY --from=builder /operation /operation
ENTRYPOINT ["/operation"]
