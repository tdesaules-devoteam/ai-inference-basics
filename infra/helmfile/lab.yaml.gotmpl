{{- $infra := .Values.infra -}}
{{/* Route only enabled releases. A stopped but installed model retains its route. */}}
{{- $scheme := ternary "http" "https" (eq $infra.environment "devenv") -}}
{{- $models := list -}}
{{- range $name, $model := $infra.models -}}
{{- if $model.enabled -}}
{{- $models = append $models $name -}}
{{- end -}}
{{- end -}}
hostname: {{ $infra.network.hostname | quote }}
nodePort: {{ $infra.network.httpsNodePort }}
localHttp: {{ eq $infra.environment "devenv" }}
origin: {{ printf "%s://%s:%v" $scheme $infra.network.hostname $infra.network.httpsNodePort | quote }}
bastionImage: {{ $infra.images.bastion | quote }}
provisionImage: {{ $infra.images.provision | quote }}
imagePullPolicy: {{ $infra.images.pullPolicy | quote }}
modelNames:
{{ $models | toYaml | indent 2 }}
splitModelGateway: {{ eq $infra.environment "devenv" }}
{{ if eq $infra.environment "devenv" -}}
apiNodePort: {{ $infra.network.apiNodePort }}
apiBaseUrl: http://agentgateway.agentgateway.svc.cluster.local/v1
{{ end -}}
modelPaths:
{{- range $name := $models }}
  {{ $name }}: {{ index (dict "chat" "/v1/chat/completions" "embeddings" "/v1/embeddings" "rerank" (ternary "/v2/rerank" "/cohere/v2/rerank" (eq $infra.environment "devenv"))) (readFile (printf "../../charts/%s/values.yaml" $name) | fromYaml).task | quote }}
{{- end }}
modelApiOrigin: {{ printf "%s://%s:%v" $scheme $infra.network.hostname (index $infra.network "apiNodePort" | default $infra.network.httpsNodePort) | quote }}
