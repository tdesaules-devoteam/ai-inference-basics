{{- $infra := .Values.infra -}}
{{/* Route only enabled releases. A stopped but installed model retains its route. */}}
{{- $models := list -}}
{{- range $name, $model := $infra.models -}}
{{- if $model.enabled -}}
{{- $models = append $models $name -}}
{{- end -}}
{{- end -}}
hostname: {{ $infra.network.hostname | quote }}
nodePort: {{ $infra.network.httpsNodePort }}
origin: {{ printf "https://%s:%v" $infra.network.hostname $infra.network.httpsNodePort | quote }}
bastionImage: {{ $infra.images.bastion | quote }}
provisionImage: {{ $infra.images.provision | quote }}
imagePullPolicy: {{ $infra.images.pullPolicy | quote }}
modelNames:
{{ $models | toYaml | indent 2 }}
splitModelGateway: {{ eq $infra.environment "devenv" }}
{{ if eq $infra.environment "devenv" -}}
apiNodePort: {{ $infra.network.apiNodePort }}
apiBaseUrl: https://agentgateway.agentgateway.svc.cluster.local/v1
{{ end -}}
modelApiOrigin: {{ printf "https://%s:%v" $infra.network.hostname (index $infra.network "apiNodePort" | default $infra.network.httpsNodePort) | quote }}
