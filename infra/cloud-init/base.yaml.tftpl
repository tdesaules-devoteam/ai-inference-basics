#cloud-config
users:
  - name: instructor
    groups: [sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}
ssh_pwauth: false
disable_root: true
package_update: true
packages: [curl, ca-certificates]
write_files:
  - path: /usr/local/sbin/bootstrap-k0s
    permissions: '0755'
    content: |
      ${bootstrap}
  - path: /etc/k0s/k0s.yaml
    permissions: '0600'
    content: |
      ${k0s_config}
runcmd:
  - [/usr/local/sbin/bootstrap-k0s]
