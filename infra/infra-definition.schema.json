{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "machines", "network", "access", "images", "storage", "models"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "environment": {"enum": ["devenv", "scaleway"]},
    "machines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "count", "cpu", "memoryGiB", "diskGiB"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "count": {"type": "integer", "minimum": 1},
          "cpu": {"type": "integer", "minimum": 1},
          "memoryGiB": {"type": "integer", "minimum": 1},
          "diskGiB": {"type": "integer", "minimum": 1},
          "instanceType": {"type": "string", "minLength": 1},
          "zone": {"type": "string", "minLength": 1}
        }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["hostname", "httpsNodePort"],
      "properties": {
        "hostname": {"type": "string", "maxLength": 253, "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"},
        "httpsNodePort": {"type": "integer", "minimum": 30000, "maximum": 32767}
      }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["adminEmail", "adminPassword", "apiBearerToken"],
      "properties": {
        "adminEmail": {"type": "string", "format": "email"},
        "adminPassword": {"type": "string", "minLength": 1, "maxLength": 72},
        "apiBearerToken": {"type": "string", "minLength": 1}
      }
    },
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["bastion", "provision", "pullPolicy"],
      "properties": {
        "bastion": {"$ref": "#/$defs/image"},
        "provision": {"$ref": "#/$defs/image"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "storage": {
      "description": "Requested RustFS volume capacity, shared by model and observability buckets.",
      "type": "object", "additionalProperties": false,
      "required": ["modelsGiB"],
      "properties": {"modelsGiB": {"type": "integer", "minimum": 1}}
    },
    "models": {
      "type": "object", "additionalProperties": false,
      "required": ["qwen3-0-6b", "qwen3-embedding-0-6b", "qwen3-reranker-0-6b", "qwen3-8b-fp8", "qwen3-embedding-4b", "qwen3-reranker-4b"],
      "properties": {
        "qwen3-0-6b": {"$ref": "#/$defs/model"},
        "qwen3-embedding-0-6b": {"$ref": "#/$defs/model"},
        "qwen3-reranker-0-6b": {"$ref": "#/$defs/model"},
        "qwen3-8b-fp8": {"$ref": "#/$defs/model"},
        "qwen3-embedding-4b": {"$ref": "#/$defs/model"},
        "qwen3-reranker-4b": {"$ref": "#/$defs/model"}
      }
    }
  },
  "$defs": {
    "image": {"type": "string", "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"},
    "model": {
      "description": "An enabled release may be stopped or skip import. A disabled release must not request replicas or import.",
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "replicas", "import"],
      "properties": {"enabled": {"type": "boolean"}, "replicas": {"enum": [0, 1]}, "import": {"type": "boolean"}},
      "if": {"properties": {"enabled": {"const": false}}},
      "then": {"properties": {"replicas": {"const": 0}, "import": {"const": false}}}
    }
  }
}
