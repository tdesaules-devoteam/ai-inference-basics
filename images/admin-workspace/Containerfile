FROM quay.io/fedora/fedora-minimal@sha256:f58854409553b5bf2cb53c6f3b82349e0c9d55ed64943a6fb6b379f4a845de62 AS tools
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN microdnf install -y tar-2:1.35-10.fc45 gzip-1.14-4.fc45 && microdnf clean all
RUN curl -fL --retry 3 https://dl.k8s.io/release/v1.37.2/bin/linux/amd64/kubectl -o /kubectl \
    && echo 'c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4  /kubectl' | sha256sum -c - \
    && chmod 755 /kubectl
RUN curl -fL --retry 3 https://github.com/zellij-org/zellij/releases/download/v0.46.0/zellij-x86_64-unknown-linux-gnu.tar.gz -o /zellij.tar.gz \
    && echo '0940e467f99ca57aec5a63edcad633450d49cd6f22e8a7d9c686771a0d9f86ae  /zellij.tar.gz' | sha256sum -c - \
    && tar -xzf /zellij.tar.gz -C / && chmod 755 /zellij

FROM quay.io/fedora/fedora-minimal@sha256:f58854409553b5bf2cb53c6f3b82349e0c9d55ed64943a6fb6b379f4a845de62 AS runtime
RUN microdnf install -y --setopt=install_weak_deps=0 \
      k9s-0.51.0-3.fc45 helm-4.2.2-1.fc45 go-task-3.54.0-1.fc45 \
      bash-5.3.15-2.fc45 jq-1.8.2-5.fc45 git-core-2.56.0-1.fc45 \
      ca-certificates-2026.2.92_v9.0.319-2.fc45 libgcc-16.2.1-3.fc45 \
      libstdc++-16.2.1-3.fc45 openssl-libs-4.0.3-1.fc45 ncurses-term-6.6-3.fc45 \
    && microdnf clean all \
    && ln -s /usr/bin/go-task /usr/local/bin/task \
    && mkdir -p /workspace && chown 1000:1000 /workspace \
    && printf 'lab:x:1000:1000:Workshop:/workspace:/bin/bash\n' >> /etc/passwd \
    && printf 'lab:x:1000:\n' >> /etc/group
COPY --from=tools /kubectl /usr/local/bin/kubectl
COPY --from=tools /zellij /usr/local/bin/zellij
COPY images/admin-workspace/entrypoint.sh /usr/local/bin/workspace-entrypoint
ENV HOME=/workspace TERM=xterm-256color SHELL=/bin/bash XDG_RUNTIME_DIR=/workspace/.run
USER 1000:1000
WORKDIR /workspace
EXPOSE 7681
ENTRYPOINT ["bash", "/usr/local/bin/workspace-entrypoint"]
